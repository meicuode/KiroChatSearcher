{
  "name": "kiro-chat-search",
  "displayName": "Kiro Chat Search",
  "description": "搜索 Kiro 当前项目的对话历史，点击可直接跳转到对应会话",
  "version": "1.4.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meicuode/KiroChatSearcher.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiroChatSearch",
          "title": "Kiro Chat Search",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kiroChatSearch": [
        {
          "id": "kiroChatSearch.entry",
          "name": "对话搜索",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "kiroChatSearch.openSearch",
        "title": "Kiro: 搜索对话历史",
        "icon": "$(search)"
      },
      {
        "command": "kiroChatSearch.toggleView",
        "title": "Kiro: 折叠/展开对话搜索"
      },
      {
        "command": "kiroChatSearch.storageReport",
        "title": "Kiro: 存储占用分析"
      },
      {
        "command": "kiroChatSearch.storageRanking",
        "title": "Kiro: 存储占用排行"
      },
      {
        "command": "kiroChatSearch.settings",
        "title": "Kiro: 对话搜索设置",
        "icon": "$(gear)"
      },
      {
        "command": "kiroChatSearch.telemetryProbe",
        "title": "Kiro: 遥测旁听可行性探查（诊断）"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kiroChatSearch.openSearch",
          "when": "view == kiroChatSearch.entry",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Chat Search",
      "properties": {
        "kiroChatSearch.pendingApproval.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Kiro 等待人工确认（批准工具调用）时，在**窗口标题**前加上 `* ` 标记，并在状态栏显示提示。\n\n标记写入**工作区**作用域的 `window.title`（多开时才能分辨是哪个窗口在等），因此等待期间 `.vscode/settings.json`（或 `.code-workspace`）会出现一处临时改动，确认后自动还原。"
        }
      }
    },
    "keybindings": [
      {
        "command": "kiroChatSearch.openSearch",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "kiroChatSearch.toggleView",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.27.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
